WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=tr

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=60

# Stereo queue hooks are inactive by default.
STEREO_QUEUE_BACKEND=rabbitmq
STEREO_WHISPER_QUEUE_ENABLED=false
STEREO_ANALYSIS_QUEUE_ENABLED=false
STEREO_WHISPER_QUEUE_NAME=stereo.whisper
STEREO_ANALYSIS_QUEUE_NAME=stereo.analysis

# RabbitMQ connection (Docker Compose defaults).
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=stereo
RABBITMQ_PASSWORD=stereo-change-me
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=60
RABBITMQ_BLOCKED_TIMEOUT=30
RABBITMQ_CONNECTION_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=2

SAMPLE_RATE=16000
BLOCK_MS=50
SPEECH_THRESHOLD=0.015
MIN_SPEECH_MS=250
END_SILENCE_MS=800
MAX_UTTERANCE_SECONDS=15

